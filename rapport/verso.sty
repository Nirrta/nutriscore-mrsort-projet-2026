% verso.sty : le style « Verso de l'emballage » du rapport du projet MR-Sort.
% Noir et blanc, filets épais et maigres comme sur un tableau nutritionnel, police Archivo.
% La couleur vient du Nutri-Score : ses classes, et ses points (rouge pour les négatifs, vert pour les positifs). Compiler avec XeLaTeX.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{verso}[2026/10/28 Style Verso du projet MR-Sort]

\RequirePackage[french]{babel}
\frenchsetup{StandardItemLabels=true}     % des puces, et non des tirets, devant les éléments de liste
\RequirePackage{fontspec}
\RequirePackage{amsmath}
\RequirePackage[a4paper, top=2.4cm, bottom=2.6cm, left=2.6cm, right=2.6cm]{geometry}
\RequirePackage{xcolor}
\RequirePackage{titlesec}
\RequirePackage{booktabs}
\RequirePackage{caption}
\RequirePackage{graphicx}
\RequirePackage{fancyhdr}
\RequirePackage{array}
\RequirePackage{calc}
\RequirePackage{longtable}
\RequirePackage{newunicodechar}
\RequirePackage[hidelinks]{hyperref}

% --- Polices : Archivo (licence OFL), instances statiques du dossier design/polices ---
\defaultfontfeatures{Ligatures=TeX}
\setmainfont{Archivo}[
  Path = ../design/polices/,
  Extension = .ttf,
  UprightFont = *-Regular,
  ItalicFont = *-Italic,
  BoldFont = *-Bold,
  Numbers = {Lining, Monospaced}]
\setsansfont{Archivo}[
  Path = ../design/polices/,
  Extension = .ttf,
  UprightFont = *-Regular,
  ItalicFont = *-Italic,
  BoldFont = *-Bold]
\newfontfamily\policeTitre{ArchivoCondensed-ExtraBold}[Path = ../design/polices/, Extension = .ttf]
\newfontfamily\policeDemiGras{Archivo-SemiBold}[Path = ../design/polices/, Extension = .ttf]
\setmonofont{Menlo}[Scale = MatchLowercase]

% Archivo n'a pas de lettres grecques : λ, ε et Σ s'écrivent en Arial
\newfontfamily\policeGrecque{Arial}
\newunicodechar{λ}{{\policeGrecque λ}}
\newunicodechar{ε}{{\policeGrecque ε}}
\newunicodechar{Σ}{{\policeGrecque Σ}}

% Les listes serrées que produit pandoc
\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

% --- Couleurs (projet_design.py) ---
\definecolor{encre}{HTML}{000000}
\definecolor{trame}{HTML}{E9E9E6}
\definecolor{secondaire}{HTML}{5C5C58}
\definecolor{classeA}{HTML}{038141}
\definecolor{classeB}{HTML}{85BB2F}
\definecolor{classeC}{HTML}{FECB02}
\definecolor{classeD}{HTML}{EE8100}
\definecolor{classeE}{HTML}{E63E11}

% --- Texte courant : 10,5 points, interligne généreux, alignement à gauche ---
\AtBeginDocument{\fontsize{10.5}{15}\selectfont}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.6em}
\raggedright

% --- Titres : Archivo Condensed sous un filet de 4 points ---
\titleformat{\section}[block]
  {\titlerule[4pt]\vspace{5pt}\policeTitre\fontsize{18}{22}\selectfont}
  {\thesection}{0.5em}{}
\titleformat{\subsection}[block]
  {\titlerule[1pt]\vspace{3pt}\policeDemiGras\fontsize{13}{16}\selectfont}
  {\thesubsection}{0.5em}{}
\titlespacing*{\section}{0pt}{2.2em}{1em}
\titlespacing*{\subsection}{0pt}{1.6em}{0.6em}

% --- Tableaux : filet épais en tête, maigre entre les lignes ---
\setlength{\heavyrulewidth}{1.6pt}
\setlength{\lightrulewidth}{0.4pt}
\setlength{\cmidrulewidth}{0.4pt}

% --- Légendes ---
\captionsetup{font={small}, labelfont={bf}, labelsep=period, justification=raggedright, singlelinecheck=false}

% --- Pied de page : le projet à gauche, la page à droite ---
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[L]{\color{secondaire}\small Projet MR-Sort, transparence des algorithmes pour la décision}
\fancyfoot[R]{\small\thepage}

% --- Pastilles de classe : \classe{A} pour le Nutri-Score, \classeModele{A} pour nos modèles ---
\newcommand{\classe}[1]{{\setlength{\fboxsep}{2pt}\colorbox{classe#1}{\policeTitre\textcolor{\ifnum`#1=`A white\else\ifnum`#1=`E white\else black\fi\fi}{#1}}}}
\newcommand{\classeModele}[1]{{\setlength{\fboxsep}{2pt}\fbox{\policeTitre #1′}}}
